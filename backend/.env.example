# =========================
# Server configuration
# =========================
PORT=5000
NODE_ENV=development

# =========================
# CORS - frontend origin(s)
# Comma-separated list, e.g.: http://localhost:3000,http://127.0.0.1:3000
# =========================
CORS_ORIGIN=http://localhost:3000

# =========================
# MySQL database
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_ordering
DB_CONNECTION_LIMIT=10

# =========================
# JWT (JSON Web Token)
# Use a long, random secret in production (at least 32 chars).
# =========================
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# =========================
# Bcrypt
# =========================
BCRYPT_SALT_ROUNDS=10

# =========================
# Default Admin (seeded on db:init if it doesn't exist)
# =========================
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@quickbite.local
ADMIN_PASSWORD=Admin@12345
